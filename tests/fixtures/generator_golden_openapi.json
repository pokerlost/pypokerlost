                      "default": null,
                      "title": "Error Message"
                    },
                    "ok": {
                      "title": "Ok",
                      "type": "boolean"
                    },
                    "result": {
                      "default": null,
                      "title": "Result",
                      "type": "null"
                    },
                    "retry_after": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
