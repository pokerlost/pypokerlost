                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "title": "PokerlostResponse[int]",
                  "type": "object"
                }
              }
            },
            "description": "Technical success"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
