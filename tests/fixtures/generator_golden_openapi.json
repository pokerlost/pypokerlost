{
  "components": {
    "schemas": {
      "TechnicalRecord": {
        "allOf": [
          {
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer"
              }
            },
            "required": [
              "count"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "client_secret": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "ready",
                  "done"
                ]
              }
            },
            "required": [
              "state",
              "client_secret"
            ],
            "type": "object"
          }
        ]
      }
    },
    "securitySchemes": {
      "PokerlostOAuth2": {
        "flows": {
          "clientCredentials": {
            "scopes": {
              "accounts.self.getMe": "Read the synthetic identity"
            },
            "tokenUrl": "/getToken"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Technical fixture",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
